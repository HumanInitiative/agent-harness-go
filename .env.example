# Copy to .env and fill in. The harness reads these from the process
# environment (internal/platform/config), so any way of setting them works:
# `set -a; source .env; set +a`, direnv, docker's --env-file, a secret manager.
#
# Startup fails with a list of every problem if anything is missing or invalid.

# ---------------------------------------------------------------- required

# Gemini API key (https://aistudio.google.com/apikey). GOOGLE_API_KEY is
# accepted as a fallback name.
GEMINI_API_KEY=

# Comma-separated API keys clients must send in the X-API-Key header.
# Minimum 32 characters each. Generate one with: openssl rand -hex 32
# Several keys can be active at once, which is how you rotate without downtime.
API_KEYS=

# ---------------------------------------------------------------- optional
# Defaults are shown.

# --- HTTP server
HTTP_ADDR=:8080
# Upper bound for one /api/v1 request, model and tool calls included.
REQUEST_TIMEOUT_SECONDS=60
# How long shutdown waits for in-flight requests. Must be >= the request
# timeout. In Kubernetes, set terminationGracePeriodSeconds above this value.
SHUTDOWN_TIMEOUT_SECONDS=70
MAX_REQUEST_BYTES=65536
# Serve Swagger UI at /swagger/index.html. Keep false in production unless the
# API documentation is meant to be public.
SWAGGER_ENABLED=false

# --- Rate limiting (per API key, per instance)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# --- Logging
# debug | info | warn | error
LOG_LEVEL=info
# json (production) | text (easier to read locally)
LOG_FORMAT=json

# --- Model
# "gemini-flash-latest" follows Google's newest Flash model. In production,
# consider pinning a specific model version so behaviour cannot change under
# you without a deploy.
GENKIT_MODEL=googleai/gemini-flash-latest

# --- Agent behaviour
# Rounds of tool calls allowed per reply before the model must answer.
MAX_TOOL_TURNS=4
# Longest accepted user message, in characters.
MAX_MESSAGE_CHARS=8000
# Prior messages sent to the model as context. 0 = every turn is independent.
HISTORY_WINDOW_MESSAGES=20
# Leave unset to use the built-in persona (internal/platform/config).
# SYSTEM_PROMPT=

# --- In-memory conversation store
# Oldest-idle conversations are evicted beyond this many.
MAX_CONVERSATIONS=10000
# Conversations idle longer than this are forgotten.
CONVERSATION_TTL_MINUTES=1440

# --- Local development only
# "dev" enables Genkit's Dev UI / trace inspector. Never set this in production.
# GENKIT_ENV=dev
