# Copy to .env and fill in. The harness reads these from the process
# environment (internal/platform/config), so any way of setting them works:
# `set -a; source .env; set +a`, direnv, docker's --env-file, a secret manager.
#
# Startup fails with a list of every problem if anything is missing or invalid.

# ---------------------------------------------------------------- required

# Gemini API key (https://aistudio.google.com/apikey). GOOGLE_API_KEY is
# accepted as a fallback name.
GEMINI_API_KEY=

# Comma-separated API keys clients must send in the X-API-Key header.
# Minimum 32 characters each. Generate one with: openssl rand -hex 32
# Several keys can be active at once, which is how you rotate without downtime.
API_KEYS=

# ---------------------------------------------------------------- optional
# Defaults are shown.

# --- HTTP server
HTTP_ADDR=:8080
# Upper bound for one /api/v1 request, model and tool calls included.
REQUEST_TIMEOUT_SECONDS=60
# How long shutdown waits for in-flight requests. Must be >= the request
# timeout. In Kubernetes, set terminationGracePeriodSeconds above this value.
SHUTDOWN_TIMEOUT_SECONDS=70
MAX_REQUEST_BYTES=65536
# Serve Swagger UI at /swagger/index.html. Keep false in production unless the
# API documentation is meant to be public.
SWAGGER_ENABLED=false

# --- Rate limiting (per API key, per instance)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# --- Logging
# debug | info | warn | error
LOG_LEVEL=info
# json (production) | text (easier to read locally)
LOG_FORMAT=json

# --- Model
# "gemini-flash-latest" follows Google's newest Flash model. In production,
# consider pinning a specific model version so behaviour cannot change under
# you without a deploy.
GENKIT_MODEL=googleai/gemini-flash-latest

# --- Agent behaviour
# Rounds of tool calls allowed per reply before the model must answer.
MAX_TOOL_TURNS=4
# Longest accepted user message, in characters.
MAX_MESSAGE_CHARS=8000
# Prior messages sent to the model as context. 0 = every turn is independent.
HISTORY_WINDOW_MESSAGES=20
# Leave unset to use the built-in persona (internal/platform/config).
# SYSTEM_PROMPT=

# --- In-memory conversation store
# Oldest-idle conversations are evicted beyond this many.
MAX_CONVERSATIONS=10000
# Conversations idle longer than this are forgotten.
CONVERSATION_TTL_MINUTES=1440

# --- Web tools (web_search, web_fetch). Nothing below is used while disabled.
WEB_TOOLS_ENABLED=false
# Self-hosted SearXNG with the JSON API enabled (see deploy/searxng/).
# Required on Indonesian networks, where DuckDuckGo is blocked by ISPs.
# SEARXNG_URL=http://127.0.0.1:8888
# Secret for the SearXNG container started by deploy/docker-compose.yml.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
# Provider order. Default: searxng,duckduckgo when SEARXNG_URL is set,
# otherwise duckduckgo.
# WEB_SEARCH_PROVIDERS=searxng,duckduckgo
WEB_SEARCH_LANGUAGE=id
# Must contain a contact URL or email so site owners can reach us. The
# default is shown; it contains spaces, so if you override it in a file that
# is `source`d, wrap the value in quotes.
# WEB_USER_AGENT=HumanInitiativeBot/1.0 (+https://github.com/HumanInitiative/agent-harness-go)
# Must be shorter than REQUEST_TIMEOUT_SECONDS.
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_MAX_BODY_BYTES=5242880
# PDFs are streamed to a temporary file, so they get their own, larger limit.
WEB_MAX_PDF_BYTES=20971520
WEB_CACHE_TTL_MINUTES=30
WEB_DOMAIN_REQUESTS_PER_SECOND=1
# Enforce robots.txt for agent-initiated fetches. When false, violations are
# only logged. (Automated crawling always enforces it.)
WEB_FETCH_RESPECT_ROBOTS=true
# How often the harness logs the web counters that changed ("web metrics":
# fetch and search outcomes, WAF blocks, cache hits). 0 turns it off.
WEB_METRICS_LOG_MINUTES=15

# --- CSR prospect index (find_csr_prospects, check_company, and csrctl)
# The index is filled by `csrctl import` + `csrctl crawl`; the tools only read it.
CSR_TOOLS_ENABLED=false
CSR_DB_PATH=data/csr.db
# Human Initiative's focus areas, regions and program types (adjust the file).
CSR_INSTITUTION_PROFILE=config/institution-profile.yaml
# check_company looks up companies that are not in the index on their own
# websites (search, CSR pages, extraction) when this is true; needs
# WEB_TOOLS_ENABLED=true. A lookup that does not finish within the timeout
# (shorter than REQUEST_TIMEOUT_SECONDS) is completed by the nightly crawl.
CSR_ON_DEMAND_ENABLED=false
CSR_ON_DEMAND_TIMEOUT_SECONDS=40
CSR_ON_DEMAND_PER_HOUR=20
# API keys allowed to record review decisions (verified / excluded) through
# the set_company_status tool, as comma-separated fingerprints: the first 12
# hex digits of the key's SHA-256, which the logs show as api_key_id
# (printf %s "$KEY" | shasum -a 256 | cut -c1-12). Empty: the tool is off.
# CSR_REVIEWER_KEY_IDS=
# A company's CSR data is labelled stale (and ranked last) when none of its
# pages was successfully checked for this long. Keep it above 90: annual
# reports are only re-checked every 90 days.
CSR_STALE_AFTER_DAYS=120
# Crawl pacing (csrctl only). Crawls are not urgent: going slowly keeps
# company WAFs and upstream search engines from blocking the server's IP,
# which a faster test crawl triggered within minutes.
CSR_CRAWL_WORKERS=4
# Sizing: route checks took about 8 s per company per worker in a measured
# crawl (pages spaced 5 s apart); model extraction of changed pages and
# large PDF downloads add to that. A run logs a warning when due companies
# are left for the next run; raise this value if that keeps happening.
CSR_CRAWL_COMPANIES_PER_RUN=100
# A run starts no new company after this long, so it stays in its window.
CSR_CRAWL_MAX_RUN_MINUTES=180
CSR_CRAWL_DOMAIN_INTERVAL_SECONDS=5
CSR_CRAWL_SEARCH_INTERVAL_SECONDS=6
# Open discovery: search for companies that fund programs but are not in the
# seed list (queries in the file below). `csrctl discover` runs it once;
# with CSR_DISCOVERY_ENABLED=true, `csrctl schedule` runs it before each
# crawl. Needs GEMINI_API_KEY.
CSR_DISCOVERY_ENABLED=false
CSR_DISCOVERY_CONFIG=config/discovery.yaml
# Annual and sustainability reports are often 50-150 MB PDFs.
CSR_CRAWL_MAX_PDF_BYTES=157286400
CSR_CRAWL_PDF_TIMEOUT_SECONDS=300

# --- Local development only
# "dev" enables Genkit's Dev UI / trace inspector. Never set this in production.
# GENKIT_ENV=dev
