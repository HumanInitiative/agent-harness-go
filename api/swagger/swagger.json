{
    "swagger": "2.0",
    "info": {
        "description": "AI agent harness with tool calling, built with Go and Genkit.",
        "title": "Human Initiative Agent Harness API",
        "contact": {
            "name": "Human Initiative Engineering"
        },
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/chat": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Sends a user message to the AI agent. The agent may call registered tools before\nreplying; every call is listed in tool_calls. Pass conversation_id to continue a\nconversation, omit it to start a new one. Turns of one conversation must be sent\none at a time.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "agent"
                ],
                "summary": "Send a message to the agent",
                "parameters": [
                    {
                        "description": "Chat request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.ChatRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ChatResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_request: malformed body, empty or oversized message, bad conversation_id",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized: missing or invalid X-API-Key",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "conversation_busy: another turn of this conversation is still running",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "request_too_large: body exceeds MAX_REQUEST_BYTES",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited: see Retry-After header",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "internal_error or tool_turn_limit",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "model_unavailable: provider overloaded; see Retry-After header",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "timeout: the reply took longer than REQUEST_TIMEOUT_SECONDS",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/outreach": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Scores the companies in the CSR index against one Human Initiative program and returns the\nbest fits with the reasons and the evidence behind them. Unless emails is false, each company\nalso gets a draft approach email written by the model, which may only claim what cited\nevidence says; whatever the checks cannot confirm is listed in the entry's notes. Every draft\nneeds human review. With format \"docx\" the response is the Word file instead of JSON.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json",
                    "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                ],
                "tags": [
                    "outreach"
                ],
                "summary": "Shortlist companies that may fund a program, with draft approach emails",
                "parameters": [
                    {
                        "description": "Outreach request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.OutreachRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "format docx",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "invalid_request: malformed body, missing focus area, bad limit or format",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized: missing or invalid X-API-Key",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "request_too_large",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "no_prospects: no indexed company fits the program",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited: see Retry-After header",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "internal_error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "model_unavailable: see Retry-After header",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "timeout",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/programs": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reports"
                ],
                "summary": "List the programs a report can be made for",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/httpapi.ProgramDTO"
                            }
                        }
                    },
                    "401": {
                        "description": "unauthorized: missing or invalid X-API-Key",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited: see Retry-After header",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "internal_error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/reports": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Builds a draft donation report for one program and period. Figures come from the donation\ndata; the narrative sections are written by the model from the program's activity\ndocuments and cite them. The draft always needs human review: notes lists what to check.\nWith format \"docx\" the response is the Word file instead of JSON.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json",
                    "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                ],
                "tags": [
                    "reports"
                ],
                "summary": "Draft a donation report",
                "parameters": [
                    {
                        "description": "Report request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.ReportRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "format docx",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "invalid_request: malformed body, bad date, unknown format",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized: missing or invalid X-API-Key",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "program_not_found or document_not_found",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "request_too_large",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "no_documents: the program has no readable activity documents",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited: see Retry-After header",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "internal_error",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "narrative_failed: the model gave no usable narrative",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "model_unavailable: see Retry-After header",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "timeout",
                        "schema": {
                            "$ref": "#/definitions/httpapi.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Liveness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.StatusResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Readiness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.StatusResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpapi.ChatRequest": {
            "type": "object",
            "properties": {
                "conversation_id": {
                    "description": "ConversationID continues an existing conversation. Omit it to start a\nnew one; the response carries the generated ID back. 1-128 characters\nof letters, digits, '-' or '_'.",
                    "type": "string",
                    "example": "3f9c9b1e-2f0a-4a3e-9b1a-6e4b6f0c1a2b"
                },
                "message": {
                    "description": "Message is the user's message to the assistant. Required; limited to\nMAX_MESSAGE_CHARS characters.",
                    "type": "string",
                    "example": "What is 12 times 7?"
                }
            }
        },
        "httpapi.ChatResponse": {
            "type": "object",
            "properties": {
                "conversation_id": {
                    "description": "ConversationID identifies the conversation; send it back on the next\nrequest to continue.",
                    "type": "string",
                    "example": "3f9c9b1e-2f0a-4a3e-9b1a-6e4b6f0c1a2b"
                },
                "reply": {
                    "description": "Reply is the assistant's final answer.",
                    "type": "string",
                    "example": "12 times 7 is 84."
                },
                "tool_calls": {
                    "description": "ToolCalls lists every tool the agent invoked, in order. Empty when it\nanswered directly.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.ToolCallDTO"
                    }
                }
            }
        },
        "httpapi.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "Code is a stable, machine-readable error identifier. Clients should\nbranch on Code, never on Error.",
                    "type": "string",
                    "enum": [
                        "invalid_request",
                        "unauthorized",
                        "not_found",
                        "method_not_allowed",
                        "conversation_busy",
                        "request_too_large",
                        "rate_limited",
                        "tool_turn_limit",
                        "internal_error",
                        "model_unavailable",
                        "timeout",
                        "client_closed_request",
                        "program_not_found",
                        "document_not_found",
                        "no_documents",
                        "narrative_failed",
                        "no_prospects"
                    ],
                    "example": "invalid_request"
                },
                "error": {
                    "description": "Error is a human-readable explanation. Its wording may change.",
                    "type": "string",
                    "example": "invalid input: message must not be empty"
                },
                "request_id": {
                    "description": "RequestID identifies the request in the server logs; include it when\nreporting a problem.",
                    "type": "string",
                    "example": "5b1f6c9e-7a0d-4c7e-8f5e-2d9a1c3b4e6f"
                }
            }
        },
        "httpapi.OutreachCompanyDTO": {
            "type": "object",
            "properties": {
                "domain": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string",
                    "example": "PT Contoh Energi"
                },
                "region": {
                    "type": "string"
                },
                "sector": {
                    "type": "string"
                },
                "verified": {
                    "description": "Verified is true only when a person confirmed the company record.",
                    "type": "boolean"
                }
            }
        },
        "httpapi.OutreachEmailDTO": {
            "type": "object",
            "properties": {
                "basis": {
                    "description": "Basis is the evidence the email cites.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.OutreachEvidenceDTO"
                    }
                },
                "body": {
                    "type": "string"
                },
                "subject": {
                    "type": "string"
                }
            }
        },
        "httpapi.OutreachEmailTraceDTO": {
            "type": "object",
            "properties": {
                "attempts": {
                    "type": "integer"
                },
                "company": {
                    "type": "string"
                },
                "duration_ms": {
                    "type": "integer"
                },
                "input_tokens": {
                    "type": "integer"
                },
                "outcome": {
                    "type": "string"
                },
                "output_tokens": {
                    "type": "integer"
                }
            }
        },
        "httpapi.OutreachEntryDTO": {
            "type": "object",
            "properties": {
                "company": {
                    "$ref": "#/definitions/httpapi.OutreachCompanyDTO"
                },
                "confirmed_at": {
                    "description": "ConfirmedAt is when the company's data was last confirmed current.",
                    "type": "string",
                    "example": "2026-09-01"
                },
                "email": {
                    "description": "Email is null when none was asked for or drafting failed (Notes say\nwhich).",
                    "allOf": [
                        {
                            "$ref": "#/definitions/httpapi.OutreachEmailDTO"
                        }
                    ]
                },
                "notes": {
                    "description": "Notes are what the reviewer must check before acting on this entry.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "programs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.OutreachProgramLineDTO"
                    }
                },
                "proposal_channel": {
                    "type": "string"
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "score": {
                    "description": "Score is 0-100; Reasons say why.",
                    "type": "integer",
                    "example": 82
                },
                "stale": {
                    "type": "boolean"
                }
            }
        },
        "httpapi.OutreachEvidenceDTO": {
            "type": "object",
            "properties": {
                "date": {
                    "type": "string",
                    "example": "2026-09-01"
                },
                "date_published": {
                    "description": "DatePublished is true when Date is the publication date, false when\nit is the date the page was retrieved.",
                    "type": "boolean"
                },
                "excerpt": {
                    "type": "string"
                },
                "id": {
                    "type": "integer",
                    "example": 11
                },
                "title": {
                    "type": "string",
                    "example": "Program TJSL"
                },
                "url": {
                    "type": "string",
                    "example": "https://contoh.co.id/csr"
                }
            }
        },
        "httpapi.OutreachProgramDTO": {
            "type": "object",
            "properties": {
                "description": {
                    "description": "Description helps the model word the email; at most 3000 characters.",
                    "type": "string",
                    "example": "Beasiswa untuk 120 anak di desa terpencil Jawa Barat."
                },
                "focus_areas": {
                    "description": "FocusAreas are the fields the program works in. At least one is\nrequired: companies are scored on it.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "pendidikan"
                    ]
                },
                "name": {
                    "description": "Name of the program. Required.",
                    "type": "string",
                    "example": "Beasiswa Anak Desa"
                },
                "program_types": {
                    "description": "ProgramTypes are the kinds of support needed.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "beasiswa"
                    ]
                },
                "regions": {
                    "description": "Regions where the program works. Empty means anywhere.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Jawa Barat"
                    ]
                }
            }
        },
        "httpapi.OutreachProgramLineDTO": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "period_end": {
                    "type": "string"
                },
                "period_start": {
                    "type": "string"
                },
                "proposal_deadline": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "httpapi.OutreachRequest": {
            "type": "object",
            "properties": {
                "emails": {
                    "description": "Emails asks for a draft email per company (the default). Set false\nfor the shortlist alone, which costs no model call.",
                    "type": "boolean",
                    "example": true
                },
                "format": {
                    "description": "Format is \"json\" (default) or \"docx\" (the shortlist as a Word file).",
                    "type": "string",
                    "enum": [
                        "json",
                        "docx"
                    ],
                    "example": "json"
                },
                "limit": {
                    "description": "Limit is the number of companies, 1-25. Defaults to 10.",
                    "type": "integer",
                    "example": 10
                },
                "program": {
                    "$ref": "#/definitions/httpapi.OutreachProgramDTO"
                }
            }
        },
        "httpapi.OutreachResponse": {
            "type": "object",
            "properties": {
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.OutreachEntryDTO"
                    }
                },
                "generated_at": {
                    "type": "string",
                    "example": "2026-10-22"
                },
                "program": {
                    "$ref": "#/definitions/httpapi.OutreachProgramDTO"
                },
                "trace": {
                    "$ref": "#/definitions/httpapi.OutreachTraceDTO"
                }
            }
        },
        "httpapi.OutreachTraceDTO": {
            "type": "object",
            "properties": {
                "duration_ms": {
                    "type": "integer"
                },
                "emails": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpapi.OutreachEmailTraceDTO"
                    }
                },
                "estimated_cost_rupiah": {
                    "description": "EstimatedCostRupiah is present only when token prices are configured.",
                    "type": "number"
                },
                "fitting": {
                    "description": "Fitting is how many companies fit the program before the cut.",
                    "type": "integer"
                },
                "input_tokens": {
                    "type": "integer"
                },
                "output_tokens": {
                    "type": "integer"
                }
            }
        },
        "httpapi.ProgramDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "ID is what ReportRequest.program_id takes.",
                    "type": "string",
                    "example": "pangan-jakarta"
                },
                "name": {
                    "description": "Name is the program's name, for people.",
                    "type": "string",
                    "example": "Bantuan Pangan Jakarta"
                }
            }
        },
        "httpapi.ReportRequest": {
            "type": "object",
            "properties": {
                "documents": {
                    "description": "Documents restricts the report to these activity documents (file\nnames). Omit it to use every document of the program.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "laporan-q1.pdf"
                    ]
                },
                "format": {
                    "description": "Format is \"json\" (default: the draft as Markdown in the response) or\n\"docx\" (the draft as a Word file).",
                    "type": "string",
                    "enum": [
                        "json",
                        "docx"
                    ],
                    "example": "json"
                },
                "from": {
                    "description": "From and To are the first and last day of the period, YYYY-MM-DD,\ninclusive.",
                    "type": "string",
                    "example": "2026-01-01"
                },
                "program_id": {
                    "description": "ProgramID is the program the report is about.",
                    "type": "string",
                    "example": "sample-program"
                },
                "to": {
                    "type": "string",
                    "example": "2026-03-31"
                }
            }
        },
        "httpapi.ReportResponse": {
            "type": "object",
            "properties": {
                "markdown": {
                    "description": "Markdown is the draft report.",
                    "type": "string"
                },
                "notes": {
                    "description": "Notes are things the reviewer must check before the draft goes out,\nfor example a number the activity documents do not contain. The same\nnotes are written into the draft.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sources": {
                    "description": "Sources are the activity documents the narrative sections cite.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "httpapi.StatusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "httpapi.ToolCallDTO": {
            "type": "object",
            "properties": {
                "arguments": {
                    "description": "Arguments is the JSON object the model supplied to the tool.",
                    "type": "object"
                },
                "duration_ms": {
                    "description": "DurationMS is how long the tool took to run.",
                    "type": "integer",
                    "example": 12
                },
                "error": {
                    "description": "Error is the tool's failure message when the call failed. A failed\ntool call does not fail the request: the model is told about the\nfailure and decides how to proceed.",
                    "type": "string"
                },
                "name": {
                    "description": "Name is the tool's identifier, e.g. \"calculator\".",
                    "type": "string",
                    "example": "calculator"
                },
                "result": {
                    "description": "Result is the tool's output when the call succeeded.",
                    "type": "string",
                    "example": "84"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "API key issued by the Human Initiative engineering team.",
            "type": "apiKey",
            "name": "X-API-Key",
            "in": "header"
        }
    }
}